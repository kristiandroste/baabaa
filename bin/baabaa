#!/bin/sh
# The `baabaa` command: runs the baabaa this file belongs to (an installed version, or a checkout), from any
# folder, with Python 3.10 or newer. The installer links ~/.local/bin/baabaa to the installed one; for a
# checkout, link it yourself once:  ln -s "$PWD/bin/baabaa" ~/.local/bin/baabaa
usable() {  # a Python 3.10 or newer, never macOS's "install the developer tools" stub
    p="$(command -v "$1" 2>/dev/null)" || return 1
    if [ "$p" = /usr/bin/python3 ] && [ "$(uname -s)" = Darwin ] && ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
        return 1
    fi
    "$p" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null
}
for py in "${BAABAA_PYTHON:-}" python3 python3.14 python3.13 python3.12 python3.11 python3.10 \
          /opt/homebrew/bin/python3 /usr/local/bin/python3 /Library/Frameworks/Python.framework/Versions/Current/bin/python3 \
          /usr/bin/python3; do
    [ -n "$py" ] || continue
    if usable "$py"; then
        # the baabaa next to this file (links resolved by Python, as `readlink -f` is not everywhere), never a
        # `baabaa` folder in the current directory
        exec "$(command -v "$py")" -c 'import os, sys
r = os.path.dirname(os.path.dirname(os.path.realpath(sys.argv.pop(1))))
sys.path[:] = [r] + [p for p in sys.path if p not in ("", ".")]
os.environ["PYTHONPATH"] = r + (os.pathsep + os.environ["PYTHONPATH"] if os.environ.get("PYTHONPATH") else "")
from baabaa.__main__ import main
main()' "$0" "$@"
    fi
done
echo "baabaa needs Python 3.10 or newer (set BAABAA_PYTHON to one)" >&2
exit 1
